# Copy to .env and fill in. Never commit .env.
# Generated values use only letters, digits, - and _ (POSTGRES_PASSWORD sits inside a URL).

# Master key of the proxy; must start with sk-.
LITELLM_MASTER_KEY=sk-change-me
# Salt key: generated once and never changed (changing it makes stored data unreadable).
LITELLM_SALT_KEY=change-me-salt
# Admin UI login user.
UI_USERNAME=admin
# Admin UI login password.
UI_PASSWORD=change-me-ui
# Password of the litellm Postgres user.
POSTGRES_PASSWORD=change-me-db
# Anthropic API key from console.anthropic.com (pay-as-you-go, not a Claude subscription).
ANTHROPIC_API_KEY=sk-ant-change-me
